{
  "name": "@assistant-mk1/external-agent-fixture",
  "version": "1.0.0",
  "private": true,
  "files": [
    "*.mjs",
    "*.d.ts"
  ],
  "type": "module",
  "exports": {
    "./manifest": {
      "types": "./manifest.d.ts",
      "default": "./manifest.mjs"
    },
    "./control-plane": {
      "types": "./control-plane.d.ts",
      "default": "./control-plane.mjs"
    },
    "./runner": {
      "types": "./runner.d.ts",
      "default": "./runner.mjs"
    },
    "./web": {
      "types": "./web.d.ts",
      "default": "./web.mjs"
    }
  },
  "dependencies": {
    "@assistant-mk1/agent-sdk": "^1.0.0"
  }
}
