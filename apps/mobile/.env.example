EXPO_PUBLIC_WORKBENCH_ORIGIN=https://assistant-mk1.vercel.app
EXPO_PUBLIC_WORKOS_CLIENT_ID=
# AuthKit domain for the WorkOS environment, without a trailing slash.
EXPO_PUBLIC_WORKOS_ISSUER=
# Optional override. The linked Expo project ID is read from app.json by default.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Public DSN. Keep SENTRY_AUTH_TOKEN server/build-only.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
# Set to the full Git SHA for internal-preview builds.
EXPO_PUBLIC_SENTRY_RELEASE=
