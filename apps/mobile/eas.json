{
  "cli": {
    "version": ">= 21.4.0 < 22.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "internal-preview": {
      "distribution": "internal",
      "channel": "internal-preview",
      "android": {
        "buildType": "apk"
      }
    }
  }
}
