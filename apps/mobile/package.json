{
  "name": "@assistant-mk1/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "eas-build-pre-install": "node scripts/configure-sentry-release.cjs",
    "prebuild": "expo prebuild",
    "ios": "expo run:ios",
    "ios:simulator": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "android": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} PATH=\"${ANDROID_HOME:-$HOME/Library/Android/sdk}/platform-tools:${ANDROID_HOME:-$HOME/Library/Android/sdk}/emulator:$PATH\" expo run:android --variant debugOptimized",
    "build:local:ios": "eas build --local --platform ios --profile development-simulator",
    "build:local:ios:simulator": "eas build --local --platform ios --profile development-simulator",
    "build:local:ios:device": "eas build --local --platform ios --profile development",
    "build:local:android": "eas build --local --platform android --profile development",
    "build:eas:ios": "eas build --platform ios --profile internal-preview",
    "build:eas:android": "eas build --platform android --profile internal-preview",
    "build:eas:ios:development": "eas build --platform ios --profile development",
    "build:eas:android:development": "eas build --platform android --profile development",
    "build:eas:ios:preview": "eas build --platform ios --profile internal-preview",
    "build:eas:android:preview": "eas build --platform android --profile internal-preview",
    "build:eas:ios:testflight": "eas build --platform ios --profile testflight --auto-submit",
    "check": "tsc --noEmit && expo config --type public",
    "export:ios": "expo export --platform ios --output-dir ../../output/mobile/ios",
    "export:android": "expo export --platform android --output-dir ../../output/mobile/android"
  },
  "dependencies": {
    "@assistant-mk1/observability": "workspace:*",
    "@assistant-mk1/workbench-client": "workspace:*",
    "@assistant-mk1/workbench-react": "workspace:*",
    "@assistant-ui/react-native": "0.1.36",
    "@sentry/react-native": "8.23.0",
    "agents": "0.20.1",
    "expo": "~57.0.12",
    "expo-auth-session": "57.0.6",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.11",
    "expo-device": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-notifications": "57.0.10",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.87.0",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "~5.9.0",
    "react-native-screens": "~4.27.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.11.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "eas-cli": "21.4.0",
    "typescript": "~6.0.3"
  }
}
